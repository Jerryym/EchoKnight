@startuml StateMachine

class PlayerStateMachine {
	- m_playerController : PlayerController
	- m_currentState : PlayerBaseState
	- m_stateFactory : PlayerStateFactory

	+ PlayerStateMachine(PlayerController playerController)
	+ void Update()
	+ void SetMoveInput(Vector2 input)
}

interface IState {
	+ void EnterState();
	+ void UpdateState();
	+ void ExitState();
}

abstract class PlayerBaseState implements IState {
	# m_stateMachine : PlayerStateMachine
	# m_subStates : Dictionary<PlayerStateEnum, PlayerBaseState>
	# m_currentSubState : PlayerBaseState

	+ PlayerBaseState(PlayerStateMachine stateMachine)
	+ {abstract} void EnterState()
	+ {abstract} void UpdateState()
	+ {abstract} void ExitState()
	+ {abstract} void CheckSwitchStates()
	+ {abstract} void InitSubStates()
	+ void UpdateStates()
	# void SwitchState(PlayerStateEnum stateEnum)
	# void SwitchSubState(PlayerStateEnum stateEnum)
}

class PlayerGroundedState extends PlayerBaseState {
	- void HandleGravity()
}

class PlayerIdleState extends PlayerBaseState {
}

class PlayerWalkState extends PlayerBaseState {
}

class PlayerRunState extends PlayerBaseState {
}

class PlayerStateFactory {
	- m_stateMachineContext : PlayerStateMachine

	+ PlayerStateFactory(PlayerStateMachine stateMachineContext)
	+ PlayerBaseState Create(PlayerStateEnum stateEnum)
}

PlayerStateMachine *-- PlayerBaseState
PlayerStateMachine *-- PlayerStateFactory
@enduml
